{
  inputs,
  lib,
  pkgs-unstable,
  ...
}:
{
  imports = [
    inputs.disko.nixosModules.disko
    inputs.sops-nix.nixosModules.sops
    ../../modules
    ./disko.nix
    ./secrets.nix
  ];

  nixpkgs.hostPlatform = "x86_64-linux";
  networking.hostName = "frogswamp";
  system.stateVersion = "26.05";

  virtualisation.vmVariant.imports = [ ./vm.nix ];

  # Zigbee dongle (SMLIGHT SLZB-07MG24, CP2102N) matched by model, not by serial number
  services.udev.extraRules = ''
    SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{product}=="SMLIGHT SLZB-07Mg24", SYMLINK+="zigbee", TAG+="systemd"
  '';

  # Generated by `just install` (nixos-facter). Absent until the first install.
  hardware.facter.reportPath = lib.mkIf (builtins.pathExists ./facter.json) ./facter.json;
  # The report's monitor entry (and its serial) is stripped, so enable GPU support explicitly
  # instead of depending on a screen being attached during install (needed for Jellyfin QSV)
  hardware.facter.detected.graphics.enable = true;

  frogswamp = {
    adminUser = "pupsich";
    adminSshKeys = [ (lib.fileContents ../../keys/admin.pub) ];
    disk = "/dev/nvme0n1";
    lan = {
      address = "192.168.101.10";
      prefixLength = 24;
      gateway = "192.168.101.1";
      subnet = "192.168.101.0/24";
    };
    tailscale.enable = true;
    homeAssistant = {
      enable = true;
      hacs = true;
      cubematrix.enable = true;
    };
    # Matter devices in HA (Matter integration → ws://localhost:5580/ws)
    matterServer.enable = true;
    jellyfin.enable = true;
    samba.enable = true;
    homepage.enable = true;
    qbittorrent = {
      enable = true;
      # line: ~260 Mbit/s down, ~120 Mbit/s up (measured 2026-10-21); leave room for everything else
      speedLimits = {
        download = 28000; # ~230 Mbit/s
        upload = 10000; # ~80 Mbit/s
        altDownload = 6000; # ~50 Mbit/s, turtle: during a match
        altUpload = 1500; # ~12 Mbit/s
      };
    };
    arr.enable = true;
    mediaProvision.enable = true;
    mediaJanitor = {
      enable = true;
      dryRun = false;
    };
    acestream.enable = true;
    football = {
      enable = true;
      kodi.host = "192.168.101.20"; # the TV; static IP set on the TV (Wi-Fi settings)
      tvRemoteEntity = "remote.living_room_philips_tv";
      tvCastEntity = "media_player.philips_tv";
    };
    # Homepage tiles that flip the General actions modes
    modeSwitch = {
      enable = true;
      modes = {
        vacation = "input_boolean.vacation";
        day_off = "input_boolean.day_off";
        guests = "input_boolean.guests_in_living_room";
      };
    };
    backup = {
      local.enable = true;
      b2 = {
        enable = true;
        repository = "s3:https://s3.eu-central-003.backblazeb2.com/frogswamp-backup";
      };
    };
    mqtt = {
      enable = true;
      zigbee2mqtt = {
        package = pkgs-unstable.zigbee2mqtt;
        # Stable link from the udev rule below; avoids the dongle serial in the repo
        serialPort = "/dev/zigbee";
      };
    };
  };
}
